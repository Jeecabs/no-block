{
  "name": "@jeecabs/no-block",
  "version": "0.1.0",
  "license": "MIT",
  "type": "module",
  "private": false,
  "description": "Finite Bash jobs yield without blocking Pi and report their exit later.",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "processes",
    "bash",
    "background-jobs"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/Jeecabs/no-block"
  },
  "pi": {
    "extensions": [
      "./extensions/processes/index.ts",
      "./extensions/processes-logs/index.ts",
      "./extensions/processes-dock/index.ts"
    ],
    "skills": [
      "./skills/no-block"
    ],
    "image": "https://raw.githubusercontent.com/Jeecabs/no-block/main/assets/no-block-logo.png"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "files": [
    "src",
    "!src/**/*.test.ts",
    "extensions",
    "!extensions/**/*.test.ts",
    "skills",
    "assets",
    "schema.json",
    "README.md",
    "CONTRIBUTING.md"
  ],
  "dependencies": {
    "@aliou/pi-utils-settings": "^0.19.1",
    "@aliou/pi-utils-ui": "^0.5.0",
    "@aliou/sh": "^0.2.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@aliou/biome-plugins": "^0.12.0",
    "@biomejs/biome": "^2.5.8",
    "@changesets/cli": "^2.27.11",
    "@earendil-works/pi-ai": "0.84.1",
    "@earendil-works/pi-coding-agent": "0.84.1",
    "@earendil-works/pi-tui": "0.84.1",
    "@golevelup/ts-vitest": "^4.0.0",
    "@types/node": "^25.0.10",
    "husky": "^9.1.7",
    "memfs": "^4.57.2",
    "ts-json-schema-generator": "^2.9.0",
    "typebox": "1.1.38",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5",
    "vitest-evals": "0.15.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "typecheck:evals": "tsc --noEmit -p tests/evals/tsconfig.json",
    "lint": "biome check",
    "format": "biome check --write",
    "gen:schema": "pi-settings-schema -p extensions/processes/config/types.ts -t ProcessConfig -o schema.json --version 0.10.6",
    "check:schema": "pi-settings-schema -p extensions/processes/config/types.ts -t ProcessConfig -o schema.json --version 0.10.6 --check",
    "check:changesets": "node scripts/check-changesets.ts",
    "check:lockfile": "pnpm install --frozen-lockfile --ignore-scripts",
    "prepare": "[ ! -d .git ] || [ ! -x node_modules/.bin/husky ] || node_modules/.bin/husky",
    "changeset": "changeset",
    "version": "changeset version",
    "test": "vitest run",
    "test:e2e": "vitest run --config vitest.e2e.config.ts",
    "test:evals": "vitest run --config tests/evals/vitest.config.ts",
    "release": "pnpm changeset publish"
  },
  "packageManager": "pnpm@11.5.1",
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    },
    "@earendil-works/pi-tui": {
      "optional": true
    },
    "typebox": {
      "optional": true
    }
  }
}
